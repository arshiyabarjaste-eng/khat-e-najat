; Engine configuration file for Khat-e Nejat project.
; Engine version: Godot 4.3-stable
;
; Project: خط نجات (Khat-e Nejat)
; A 2D line-drawing puzzle game with Iranian visual identity,
; targeting Android (Cafe Bazaar) and Desktop (for testing).
;
; IMPORTANT: This file is generated/edited by hand. Open in Godot 4.3+.

config_version=5

[application]

config/name="خط نجات"
config/description="بازی معمایی دوبعدی مبتنی بر رسم خطوط با هویت ایرانی. کشیدن خط برای نجات شخصیت‌ها و اشیا از خطر."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icons/icon.svg"
config/version="0.1.0"

[autoload]

GameManager="*res://scripts/game_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

; Touch input is captured automatically on Android. We map mouse
; to the same actions for desktop testing.
ui_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194319,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}
ui_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194321,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}
ui_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194320,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}
ui_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194322,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}
draw_line={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1,"canceled":false,"pressed":false,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_mask":0,"pen_inverted":false,"double_click":false), Object(InputEventScreenTouch,"index":0,"pressed":false,"position":Vector2(0, 0))]
}
start_sim={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}
clear_line={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":67,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}
retry={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":82,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}
undo_line={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":90,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"pressed":false,"key_repeat":false)]
}

[layer_names]

2d_physics/layer_1="world"        ; static walls, terrain
2d_physics/layer_2="player"      ; the rescue target (cat, ball, etc.)
2d_physics/layer_3="hazard"      ; hazards (cars, gaps)
2d_physics/layer_4="goal"        ; goal areas
2d_physics/layer_5="drawn_line"  ; user-drawn physics lines

[physics]

2d/default_gravity=980.0
2d/sleep_threshold=20.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_to_pixels=true

[gui]

theme/custom="res://assets/themes/persian_theme.tres"
theme/custom_font="res://assets/fonts/Vazirmatn-Regular.ttf"

[internationalization]

locale/fallback="fa"
locale/test="fa"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[android]

config/package="com.khatenejat.game"
config/name="خط نجات"
config/version_code=1
config/version_name="0.1.0"
config/min_sdk=21
config/target_sdk=34
config/architectures="arm64-v8a,armeabi-v7a"
launcher_icons/main_192x192="res://assets/icons/icon_192.png"
launcher_icons/adaptive_foreground_432x432="res://assets/icons/icon_fg.png"
launcher_icons/adaptive_background_432x432="res://assets/icons/icon_bg.png"
use_custom_block_color=true
custom_block_color=Color(0.078, 0.235, 0.294, 1)
